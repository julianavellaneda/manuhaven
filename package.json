{
  "name": "manuhaven",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source writing studio for novelists: browser manuscript editor, AI editorial assistance, EPUB/PDF export, and royalty tracking.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julianavellaneda/manuhaven.git"
  },
