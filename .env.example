# =============================================================================
# ManuHaven — environment example
#
# Docker:       ./scripts/setup.sh    (copies this to .env and generates the
#                                      four secrets marked "setup.sh" below)
# Development:  cp .env.example .env.local, then set BETTER_AUTH_SECRET.
# Never commit either file.
#
# Only the database and BETTER_AUTH_SECRET are required. With nothing else set
# you get a working studio -- email/password sign-in, editor, import,
# formatting, royalties, files on disk -- and the AI features stay inert until
# a key is configured (either here or, per user, in Settings -> AI).
#
# Keep comments on their own lines: Docker Compose reads a comment after an
# empty value as the value itself.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Required for `docker compose up` (setup.sh): the compose file builds the
# app's DATABASE_URL from it. Use URL-safe characters: openssl rand -hex 32
POSTGRES_PASSWORD=
# Host-side development against `bun run db:up` (compose.dev.yml, loopback
# only). Ignored under docker-compose.yml, which sets its own.
DATABASE_URL=postgres://manuhaven:manuhaven@localhost:5432/manuhaven

# --- App ---------------------------------------------------------------------
# Your public origin, exactly as the browser sees it. Auth uses it as its base
# URL and trusts only this origin; canonical URLs use it too. Read at runtime.
# Required in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Host port docker-compose.yml publishes the app on. Defaults to 3000.
APP_PORT=

# --- Auth (Better Auth) ------------------------------------------------------
# Required (setup.sh). Signs sessions and tokens; changing it signs everyone
# out.  openssl rand -hex 32
BETTER_AUTH_SECRET=
# "false" stops new accounts from every sign-in method.
AUTH_ALLOW_SIGNUP=true
# "true" makes new accounts confirm their email first. Needs SMTP.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Google sign-in, enabled when both are set. Authorised redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (magic links, password resets) ------------------------------------
# Any SMTP relay. Without SMTP_HOST those flows are hidden (in development they
# print to the server console instead).
# Local dev with Mailpit (`bun run db:up`): SMTP_HOST=localhost, SMTP_PORT=1025,
# inbox at http://localhost:8025.
SMTP_HOST=
# 587 (STARTTLS) by default; 465 means implicit TLS.
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Defaults to "ManuHaven <no-reply@localhost>".
SMTP_FROM=

# --- Storage -----------------------------------------------------------------
# fs (default): files under STORAGE_DIR. s3: any S3-compatible bucket.
STORAGE_DRIVER=fs
# fs root. Defaults to ./.data/files; docker-compose.yml pins /data/files.
STORAGE_DIR=
# s3 only. Leave S3_ENDPOINT empty for AWS; S3_FORCE_PATH_STYLE=false for AWS
# virtual-hosted buckets.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- AI ----------------------------------------------------------------------
# Encrypts user-supplied API keys before they are stored (setup.sh). Required
# only if you want users to be able to save their own key in Settings -> AI.
# Changing it makes saved keys unreadable; users re-enter them.
#   openssl rand -base64 32
AI_KEY_ENCRYPTION_SECRET=

# Optional fallback keys, used when a user has not brought their own. A purely
# self-hosted install usually leaves these blank and lets each user supply one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model overrides, as "provider:modelId". Users can override these
# per account in Settings -> AI.
#   ASSISTANT_CHAT_MODEL=anthropic:claude-sonnet-4-6
#   ASSISTANT_UTILITY_MODEL=anthropic:claude-haiku-4-5
ASSISTANT_CHAT_MODEL=
ASSISTANT_UTILITY_MODEL=

# Dev only: disable the per-manuscript cooldowns so you can iterate on prompts
# without clearing manuscripts.last_ai_*_at by hand. NEVER set in production.
# (Cooldowns already do not apply to users running on their own API key.)
AI_RATELIMIT_DISABLED=

# --- EPUB/PDF converter ------------------------------------------------------
# The export service from services/converter. Without it the studio works but
# exports fail. docker-compose.yml points the app at http://converter:3001;
# for `bun run converter:up` use http://localhost:3001 and key manuhaven-dev.
CONVERTER_URL=http://localhost:3001
# Shared secret (setup.sh); the converter rejects every request until it is set.
CONVERTER_API_KEY=

# --- PostHog (optional analytics) --------------------------------------------
# When unset the SDK no-ops. Never receives manuscript content.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional host override. Defaults to https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=
